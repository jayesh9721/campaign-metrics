# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Meta Marketing API
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_906650389058071

# Set to "true" to also ingest synthetic LinkedIn/"other" data (spec Part 11).
# Off by default so a routine sync stays Meta-only.
ENABLE_MOCK_CONNECTORS=false

# LLM - routed through OpenRouter (OpenAI-compatible endpoint), model anthropic/claude-sonnet-5
OPENROUTER_API_KEY=

# Google Ads (not wired yet - stub connector)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Internal - shared secret so pg_cron/Edge Functions can call FastAPI job endpoints
PIPELINE_TRIGGER_SECRET=
